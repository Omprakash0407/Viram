[TEMPLATE]
# Copy to .env and adjust. Never commit .env.

# --- App ---
APP_NAME=VIRAM API
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# --- Database (matches docker-compose db service) ---
DATABASE_URL=postgresql+asyncpg://viram:viram@localhost:5432/viram

# --- Auth (generate your own values; see README) ---
JWT_SECRET_KEY=changeme-generate-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- External API keys (placeholders only; fill values when integration phases begin) ---
# See docs/DATABASE_DESIGN.md — External API Dependencies and key management
# Payment gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Weather provider
WEATHER_API_KEY=
# Maps/routing provider
MAPS_API_KEY=
# AI chat — Vira AI (beta). Get a free key at https://aistudio.google.com/apikey
# Leave empty to keep Vira AI disabled (the endpoint says so honestly).
# NOTE the VIRAM_ prefix: all app settings read VIRAM_<NAME>.
VIRAM_GEMINI_API_KEY=
VIRAM_GEMINI_MODEL=gemini-3.1-flash-lite-preview
# Object storage (S3-compatible) for media
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
